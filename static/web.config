<?xml version="1.0" encoding="UTF-8"?>
<!--
  RIELBUILD static website on Windows / IIS (ASP.NET 4.x for the estimate form only).
  Estimate requests are emailed with the settings below and also written to App_Data\estimate-requests.log.
-->
<configuration>
  <appSettings>
    <!-- Who receives estimate requests (comma separated) and the sender address. -->
    <add key="Rb.MailTo" value="contact@rielbuild.ca" />
    <add key="Rb.MailFrom" value="contact@rielbuild.ca" />
    <!-- Outgoing mail server. Leave SmtpHost empty to use the host's default (localhost). -->
    <add key="Rb.SmtpHost" value="" />
    <add key="Rb.SmtpPort" value="587" />
    <add key="Rb.SmtpUser" value="" />
    <add key="Rb.SmtpPass" value="" />
    <add key="Rb.SmtpSsl" value="true" />
  </appSettings>

  <system.web>
    <compilation debug="false" />
    <httpRuntime maxRequestLength="64" enableVersionHeader="false" />
    <customErrors mode="RemoteOnly" />
  </system.web>

  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <directoryBrowse enabled="false" />

    <security>
      <requestFiltering>
        <fileExtensions>
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".md" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".avif" />
      <mimeMap fileExtension=".avif" mimeType="image/avif" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".mp4" />
      <mimeMap fileExtension=".mp4" mimeType="video/mp4" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".xml" />
      <mimeMap fileExtension=".xml" mimeType="application/xml; charset=utf-8" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>

    <!-- The site's own designed "page not found" page. -->
    <httpErrors errorMode="Custom" existingResponse="Auto">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=(), payment=()" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

  <!-- Photos, fonts, styles and scripts are versioned, so browsers keep them for a year. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="uploads">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- Addresses from the previous rielbuild.ca, sent to their new pages (keeps Google links working). -->
  <location path="contact.html">
    <system.webServer><httpRedirect enabled="true" destination="/contact/" exactDestination="true" httpResponseStatus="Permanent" /></system.webServer>
  </location>
  <location path="design-build.html">
    <system.webServer><httpRedirect enabled="true" destination="/services/" exactDestination="true" httpResponseStatus="Permanent" /></system.webServer>
  </location>
  <location path="remodeling-renovation.html">
    <system.webServer><httpRedirect enabled="true" destination="/services/home-renovation/" exactDestination="true" httpResponseStatus="Permanent" /></system.webServer>
  </location>
  <location path="riel-construction.html">
    <system.webServer><httpRedirect enabled="true" destination="/about/" exactDestination="true" httpResponseStatus="Permanent" /></system.webServer>
  </location>
  <location path="kitchen-bath">
    <system.webServer><httpRedirect enabled="true" destination="/services/kitchen-renovation/" exactDestination="true" httpResponseStatus="Permanent" /></system.webServer>
  </location>
</configuration>
