<?xml version="1.0" encoding="UTF-8"?>
<!--
  RIELBUILD static website on Windows / IIS (ASP.NET 4.x for the estimate form only).
  Estimate requests are emailed with the settings below and also written to App_Data\estimate-requests.log.
-->
<configuration>
  <appSettings>
    <!-- Who receives estimate requests (comma separated) and the sender address. -->
    <add key="Rb.MailTo" value="contact@rielbuild.ca" />
    <add key="Rb.MailFrom" value="contact@rielbuild.ca" />
    <!-- Outgoing mail server: the web server's own relay (works on rielbuild.ca). For a login-based server, set host, 587, user, password and Ssl true. -->
    <add key="Rb.SmtpHost" value="localhost" />
    <add key="Rb.SmtpPort" value="25" />
    <add key="Rb.SmtpUser" value="" />
    <add key="Rb.SmtpPass" value="" />
    <add key="Rb.SmtpSsl" value="false" />
  </appSettings>

  <system.web>
    <compilation debug="false" targetFramework="4.5" />
    <httpRuntime targetFramework="4.5" maxRequestLength="64" enableVersionHeader="false" />
    <customErrors mode="RemoteOnly" />
  </system.web>

  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <directoryBrowse enabled="false" />

    <!-- Needs the IIS URL Rewrite module: one address for Google, https://rielbuild.ca/ -->
    <rewrite>
      <rules>
        <rule name="Canonical host and https" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAny">
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_HOST}" pattern="^www\." />
          </conditions>
          <action type="Redirect" url="https://rielbuild.ca/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <fileExtensions>
          <remove fileExtension=".log" />
          <add fileExtension=".log" allowed="false" />
          <remove fileExtension=".md" />
          <add fileExtension=".md" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".avif" />
      <mimeMap fileExtension=".avif" mimeType="image/avif" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".mp4" />
      <mimeMap fileExtension=".mp4" mimeType="video/mp4" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".xml" />
      <mimeMap fileExtension=".xml" mimeType="application/xml; charset=utf-8" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>

    <!-- The site's own designed "page not found" page (File mode keeps the 404 status for Google). -->
    <httpErrors errorMode="Custom" existingResponse="Auto">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="404.html" responseMode="File" />
    </httpErrors>

    <httpProtocol>
      <customHeaders>
        <!-- Each header is removed first so a server-wide copy never causes a duplicate entry error. -->
        <remove name="X-Powered-By" />
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <remove name="X-Frame-Options" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <remove name="Permissions-Policy" />
        <add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=(), payment=()" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

  <!-- Photos, fonts, styles and scripts are versioned, so browsers keep them for a year. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="uploads">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- Addresses from the previous rielbuild.ca, sent to their new pages (keeps Google links working). -->
  <location path="contact.html">
    <system.webServer><httpRedirect enabled="true" destination="/contact/" exactDestination="true" httpResponseStatus="Permanent" /></system.webServer>
  </location>
  <location path="design-build.html">
    <system.webServer><httpRedirect enabled="true" destination="/services/" exactDestination="true" httpResponseStatus="Permanent" /></system.webServer>
  </location>
  <location path="remodeling-renovation.html">
    <system.webServer><httpRedirect enabled="true" destination="/services/home-renovation/" exactDestination="true" httpResponseStatus="Permanent" /></system.webServer>
  </location>
  <location path="riel-construction.html">
    <system.webServer><httpRedirect enabled="true" destination="/about/" exactDestination="true" httpResponseStatus="Permanent" /></system.webServer>
  </location>
  <location path="kitchen-bath">
    <system.webServer><httpRedirect enabled="true" destination="/services/kitchen-renovation/" exactDestination="true" httpResponseStatus="Permanent" /></system.webServer>
  </location>
</configuration>
